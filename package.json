{
  "name": "ai-desktop-pet",
  "version": "0.1.12",
  "description": "An AI pet that stays with you while you are working",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && electron . --dev\"",
    "build": "vite build",
    "dist": "node scripts/make-icon.js && vite build && cross-env CSC_LINK= electron-builder"
  },
  "build": {
    "appId": "com.petto.app",
    "productName": "Petto",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-renderer/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}.Setup.${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "dvntonway",
      "repo": "ai-desktop-pet"
    },
    "protocols": [
      {
        "name": "Petto",
        "schemes": [
          "petto"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "lottie-react": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^32.2.6",
    "electron-builder": "^26.0.12",
    "jimp": "^1.6.0",
    "png-to-ico": "^3.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
